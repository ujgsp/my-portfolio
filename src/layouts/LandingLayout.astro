---
import "../styles/global.css";
import { Font } from "astro:assets";
import { SITE_SETTINGS } from "../site.config";
import TurnstileController from "../components/integrations/turnstile/TurnstileController.astro";
import ScrollToTop from "../components/ui/ScrollToTop.astro";
import Link from "../components/ui/link/Link.astro";

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
}

const {
    title = SITE_SETTINGS.title,
    description = SITE_SETTINGS.description,
    ogImage = SITE_SETTINGS.ogImages,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="id" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />

        <Font cssVariable="--font-inter" />
        <Font cssVariable="--font-jet-brains-mono" />

        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        {
            ogImage && (
                <>
                    <meta
                        property="og:image"
                        content={new URL(ogImage, Astro.site || Astro.url)}
                    />
                    <meta
                        property="og:image:secure_url"
                        content={new URL(ogImage, Astro.site || Astro.url)}
                    />
                    <meta property="og:image:type" content="image/png" />
                    <meta property="og:image:width" content="1200" />
                    <meta property="og:image:height" content="630" />
                    <meta property="og:image:alt" content={title} />
                </>
            )
        }

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {
            ogImage && (
                <meta
                    name="twitter:image"
                    content={new URL(ogImage, Astro.site || Astro.url)}
                />
            )
        }

        {/* JSON-LD Service Schema */}
        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "Service",
                name: title,
                description: description,
                provider: {
                    "@type": "Person",
                    name: SITE_SETTINGS.owner,
                    url: Astro.site?.toString(),
                },
                image: ogImage
                    ? new URL(ogImage, Astro.site || Astro.url).toString()
                    : undefined,
            })}
        />

        <script is:inline>
            try {
                const stored = localStorage.getItem("theme");
                const prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                ).matches;
                const isDark = stored ? stored === "dark" : prefersDark;
                document.documentElement.classList.toggle("dark", isDark);
            } catch {}
        </script>

        <TurnstileController />
        <script
            src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileAPILoad"
            defer
            referrerpolicy="origin"
            crossorigin="anonymous"></script>
    </head>

    <body
        class="bg-white text-neutral-950 dark:bg-neutral-900 dark:text-neutral-50"
    >
        <!-- Simple Branding Header -->
        <header
            class="py-4 sm:py-6 border-b border-neutral-100 bg-white/80 backdrop-blur-md sticky top-0 z-50 dark:border-neutral-800 dark:bg-neutral-900/80"
        >
            <div
                class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center gap-2 sm:gap-0"
            >
                <Link
                    href="/"
                    variant="plain"
                    class="text-xl font-bold tracking-tight hover:text-blue-600 dark:hover:text-yellow-400"
                >
                    <span class="block sm:hidden">{title}</span>
                    <span class="hidden sm:block">{SITE_SETTINGS.title}</span>
                </Link>
                <div
                    class="text-[10px] sm:text-sm text-gray-500 uppercase tracking-widest font-semibold text-center sm:text-left"
                >
                    # Bangun dan Jalankan Sistem yang Siap Digunakan
                </div>
            </div>
        </header>

        <main id="main">
            <slot />
        </main>

        <!-- Simple Landing Footer -->
        <footer
            class="py-12 md:py-16 bg-neutral-50 dark:bg-neutral-950 border-t border-neutral-200 dark:border-neutral-800"
        >
            <div
                class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center text-gray-600 dark:text-gray-400"
            >
                <p class="text-xs sm:text-sm font-medium">
                    &copy; {new Date().getFullYear()}
                    {SITE_SETTINGS.title}. Semua Hak Dilindungi.
                </p>
                <div class="mt-6 flex justify-center space-x-8">
                    <Link
                        href="/services"
                        variant="plain"
                        class="text-[10px] sm:text-xs uppercase tracking-widest font-bold hover:text-blue-600 dark:hover:text-yellow-400"
                        >Layanan Lainnya</Link
                    >
                    <Link
                        href="/"
                        variant="plain"
                        class="text-[10px] sm:text-xs uppercase tracking-widest font-bold hover:text-blue-600 dark:hover:text-yellow-400"
                        >Beranda</Link
                    >
                </div>
            </div>
        </footer>

        <ScrollToTop />
    </body>
</html>

---
import Container from "../components/layouts/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const faqs = [
  {
    question: "Berapa lama proses pengerjaan setup server atau deployment?",
    answer: "Untuk setup server standar atau pengerjaan deployment Laravel, biasanya memakan waktu 1-2 hari kerja setelah semua akses (VPS & Domain) saya terima.",
  },
  {
    question: "Apa saja yang perlu saya siapkan sebelum pengerjaan?",
    answer: "Anda cukup menyiapkan akses ke VPS (biasanya berupa alamat IP dan password root) serta akses ke panel domain jika ingin melakukan setup SSL/HTTPS.",
  },
  {
    question: "Apakah layanan n8n sudah termasuk biaya server/VPS?",
    answer: "Belum. Biaya yang tertera adalah untuk jasa pemetaan alur dan pembangunan workflow automasi. Biaya sewa server (VPS) bulanan ditanggung oleh klien, namun saya bisa membantu merekomendasikan provider yang sesuai.",
  },
  {
    question: "Dapatkah Anda membantu jika aplikasi Laravel saya Error 500?",
    answer: "Ya, itu adalah salah satu cakupan utama layanan 'Beresin Deploy Laravel'. Saya akan melacak penyebabnya melalui error log server dan memperbaikinya agar aplikasi kembali online.",
  },
  {
    question: "Apakah ada dukungan teknis setelah pengerjaan selesai?",
    answer: "Saya memberikan garansi pengecekan dan dukungan teknis selama 3 hari setelah serah terima untuk memastikan seluruh konfigurasi berjalan stabil sesuai kesepakatan.",
  },
];
---

<BaseLayout
  title="FAQ"
  description="Pertanyaan yang sering diajukan."
>
  <Container class="py-12 space-y-12">
    <div class="space-y-4">
      <h1 class="text-4xl font-bold tracking-tight">FAQ</h1>
      <p class="text-xl text-neutral-500 dark:text-neutral-400">
        Pertanyaan yang sering diajukan seputar layanan pengembangan web.
      </p>
    </div>

    <div class="max-w-3xl divide-y divide-neutral-200 dark:divide-neutral-800">
      {
        faqs.map((faq) => (
          <details class="group py-6 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between text-neutral-900 dark:text-neutral-100">
              <h2 class="text-lg font-medium">{faq.question}</h2>
              <span class="relative ml-4 size-5 shrink-0">
                <svg
                  class="absolute inset-0 size-5 opacity-100 transition-opacity group-open:opacity-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14" />
                  <path d="M12 5v14" />
                </svg>
                <svg
                  class="absolute inset-0 size-5 opacity-0 transition-opacity group-open:opacity-100 text-brand-500 dark:text-brand-400"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="mt-4 text-neutral-600 dark:text-neutral-400 leading-relaxed">
              {faq.answer}
            </p>
          </details>
        ))
      }
    </div>
  </Container>
</BaseLayout>

---
import { getCollection } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";
import LandingLayout from "../../layouts/LandingLayout.astro";
import { render } from "astro:content";
import OptimizedImage from "../../components/ui/OptimizedImage.astro";
import Prose from "../../components/content/Prose.astro";
import PostMeta from "../../components/content/PostMeta.astro";
import LeadFunnelForm from "../../components/ui/LeadFunnelForm.astro";
import WhatsappCTA from "../../components/ui/WhatsappCTA.astro";
import { attachMeta } from "../../utils/meta";
import { SITE_SETTINGS } from "../../site.config";

export async function getStaticPaths() {
    const services = await getCollection("services", ({ data }) => !data.draft);

    return services.map((service) => ({
        params: { id: service.id },
        props: { service: attachMeta(service) },
    }));
}

const { service } = Astro.props;
const { Content } = await render(service);
---

{
    service.data.isLandingPage ? (
        <LandingLayout 
            title={service.data.title} 
            description={service.data.description}
            ogImage={service.data.image.src}
            price={service.data.price}
            tags={service.data.tags}
        >
            <article class="mx-auto max-w-3xl px-4 py-8 md:py-12 sm:px-6 lg:px-8">
                {service.data.showMetadata && <PostMeta entry={service} />}
                
                {!service.data.showMetadata && (
                    <header class="mb-8 md:mb-10 text-center">
                        <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-3">{service.data.title}</h1>
                        <p class="text-base md:text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto mb-6">{service.data.description}</p>
                        <OptimizedImage
                            src={service.data.image.src}
                            alt={service.data.image.alt}
                            loading="eager"
                            fetchpriority="high"
                            wrapperClass="aspect-video rounded-xl overflow-hidden shadow-xl shadow-blue-500/10 dark:shadow-none"
                            imageClass="w-full h-full object-cover"
                        />
                    </header>
                )}
                
                <div class="mt-8 md:mt-10">
                    <Prose>
                        <Content />
                    </Prose>
                </div>
                
                <div class="mt-12 md:mt-16">
                    <LeadFunnelForm serviceTitle={service.data.title} />
                    
                    {SITE_SETTINGS.whatsappNumber && (
                        <div class="mt-8 text-center">
                            <WhatsappCTA 
                                number={SITE_SETTINGS.whatsappNumber} 
                                message={`Halo, saya tertarik dengan layanan '${service.data.title}'`} 
                                text="Chat via WhatsApp"
                            />
                        </div>
                    )}
                </div>
            </article>
        </LandingLayout>
    ) : (
        <PostLayout entry={service} />
    )
}

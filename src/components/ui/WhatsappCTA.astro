---
import { Icon } from "astro-icon/components";
import { cn } from "../../utils/styles";

interface Props {
    number: string;
    message?: string;
    text?: string;
    class?: string;
}

const { 
    number, 
    message = "Halo, saya tertarik dengan layanan Anda.", 
    text = "Pesan Sekarang via WhatsApp",
    class: cls = "" 
} = Astro.props;

const whatsappUrl = `https://wa.me/${number.replace(/\D/g, '')}?text=${encodeURIComponent(message)}`;
---

<a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class={cn(
        "flex sm:inline-flex items-center justify-center gap-3 px-6 py-4 md:px-8 md:py-4 bg-[#25D366] hover:bg-[#20ba59] text-white text-sm md:text-base font-bold rounded-full transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl",
        cls
    )}
>
    <Icon name="lucide:message-circle" class="size-5 md:size-6" />
    <span>{text}</span>
</a>
